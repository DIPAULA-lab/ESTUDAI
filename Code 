<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EstudAI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary:  '#FF6B4A',
            'primary-light': '#FF8A70',
            'primary-dark':  '#E5542F',
            dark:     '#0F1117',
            'dark-2': '#1A1D27',
            'dark-3': '#252836',
            apoio1:   '#3B82F6',
            apoio2:   '#10B981',
            apoio3:   '#8B5CF6',
            fundo:    '#F4F5F7',
            'surface': '#FFFFFF',
          },
          fontFamily: {
            sans:    ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['Sora', 'sans-serif'],
          },
          boxShadow: {
            'card': '0 1px 3px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.06)',
            'card-hover': '0 4px 6px rgba(0,0,0,.07), 0 10px 28px rgba(0,0,0,.10)',
          }
        },
      },
    }
  </script>
  <style>
    * { font-family: 'Plus Jakarta Sans', sans-serif; }
    .logo-text { font-family: 'Sora', sans-serif; }

    /* Sidebar */
    .sidebar-link { transition: background .12s, color .12s; }
    .sidebar-link:hover  { background: rgba(255,107,74,.12); color: #FF6B4A; }
    .sidebar-link.active { background: rgba(255,107,74,.15); color: #FF6B4A; border-left: 3px solid #FF6B4A; }

    /* Pages */
    .page { display: none; }
    .page.active { display: flex; flex-direction: column; flex: 1; }
    #auth-page { display: none; }
    #auth-page.active { display: flex; }

    /* Cards */
    .card-hover { transition: transform .18s, box-shadow .18s; }
    .card-hover:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(0,0,0,.12); }

    /* XP gradient */
    .xp-gradient { background: linear-gradient(135deg, #FF6B4A, #FF3D1F); }

    /* Skeleton */
    .skeleton { background: linear-gradient(90deg, #e8eaed 25%, #f4f5f7 50%, #e8eaed 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
    @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 99px; }

    /* Typing indicator */
    .typing-dot { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: typing-bounce 1.2s infinite; }
    .typing-dot:nth-child(2) { animation-delay: .2s; }
    .typing-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes typing-bounce { 0%,80%,100% { transform: scale(0.7); opacity:.5; } 40% { transform: scale(1); opacity:1; } }

    /* Progress ring */
    .progress-ring { transform: rotate(-90deg); }

    /* Auth fade */
    @keyframes fadeUp { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
    .fade-up { animation: fadeUp .45s ease both; }

    /* Notification dot */
    .notif-dot { position:absolute; top:6px; right:6px; width:8px; height:8px; background:#FF6B4A; border-radius:50%; border:2px solid white; }

    /* Quiz option */
    .quiz-option { transition: all .15s; }
    .quiz-option:hover:not(:disabled) { border-color:#FF6B4A; background:rgba(255,107,74,.05); }
    .quiz-option.correct { border-color:#10B981; background:rgba(16,185,129,.08); }
    .quiz-option.wrong   { border-color:#EF4444; background:rgba(239,68,68,.08); }

    /* Badge pulse */
    @keyframes badge-pop { 0% { transform:scale(1); } 50% { transform:scale(1.15); } 100% { transform:scale(1); } }
    .badge-pop { animation: badge-pop .4s ease; }

    /* Podcast wave */
    @keyframes wave { 0%,100% { height:4px; } 50% { height:14px; } }
    .wave-bar { width:3px; border-radius:2px; background:#FF6B4A; display:inline-block; animation: wave 1s ease-in-out infinite; }
    .wave-bar:nth-child(2) { animation-delay:.15s; }
    .wave-bar:nth-child(3) { animation-delay:.3s; }
    .wave-bar:nth-child(4) { animation-delay:.15s; }

    /* Mobile nav label */
    .mobile-nav-btn.active span.nav-icon { color: #FF6B4A; }
    .mobile-nav-btn.active span.nav-label { color: #FF6B4A; }

    /* Role badge */
    .role-badge { font-size:10px; padding:2px 8px; border-radius:99px; font-weight:600; }

    /* Flashcard flip */
    .flashcard-scene { perspective:1000px; cursor:pointer; }
    .flashcard-inner { position:relative; width:100%; height:100%; transition:transform .6s; transform-style:preserve-3d; }
    .flashcard-scene.flipped .flashcard-inner { transform:rotateY(180deg); }
    .flashcard-front, .flashcard-back { position:absolute; width:100%; height:100%; backface-visibility:hidden; border-radius:16px; display:flex; align-items:center; justify-content:center; padding:24px; }
    .flashcard-back { transform:rotateY(180deg); }
  </style>
</head>
<body class="bg-fundo text-dark antialiased">

<!-- ══════════════════════════════════════════════════════
     AUTH PAGE
══════════════════════════════════════════════════════ -->
<div id="auth-page" class="min-h-screen bg-gradient-to-br from-dark via-dark-2 to-dark-3 items-center justify-center p-4">
  <div class="w-full max-w-md fade-up">

    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2.5 mb-3">
        <div class="w-11 h-11 rounded-2xl xp-gradient flex items-center justify-center shadow-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <span class="logo-text text-3xl font-bold text-white tracking-tight">EstudAI</span>
      </div>
      <p class="text-slate-400 text-sm">Plataforma de aprendizado com IA</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl p-8 shadow-2xl">
      <!-- Tabs -->
      <div class="flex gap-1 bg-slate-100 rounded-xl p-1 mb-6">
        <button onclick="switchAuthTab('login')" id="tab-login" class="flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all bg-white text-dark shadow-sm">Entrar</button>
        <button onclick="switchAuthTab('register')" id="tab-register" class="flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all text-slate-500">Cadastrar</button>
      </div>

      <!-- Login Form -->
      <div id="form-login" class="space-y-4">
        <!-- Role selector -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-2 uppercase tracking-wide">Entrar como</label>
          <div class="grid grid-cols-2 gap-2">
            <button onclick="selectRole('student')" id="role-student" class="role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-primary bg-primary/5 text-sm font-medium text-primary transition">
              <span class="text-base">🎓</span> Aluno
            </button>
            <button onclick="selectRole('teacher')" id="role-teacher" class="role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 text-sm font-medium text-slate-500 transition hover:border-slate-300">
              <span class="text-base">👩‍🏫</span> Professor
            </button>
            <button onclick="selectRole('principal')" id="role-principal" class="role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 text-sm font-medium text-slate-500 transition hover:border-slate-300">
              <span class="text-base">🏫</span> Diretor
            </button>
            <button onclick="selectRole('manager')" id="role-manager" class="role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 text-sm font-medium text-slate-500 transition hover:border-slate-300">
              <span class="text-base">🗂️</span> Gestor
            </button>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">E-mail institucional</label>
          <input type="email" placeholder="usuario@escola.edu.br" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Senha</label>
          <div class="relative">
            <input type="password" id="login-password" placeholder="••••••••" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition pr-10" />
            <button onclick="togglePassword('login-password')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">👁</button>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-sm text-slate-600 cursor-pointer">
            <input type="checkbox" class="rounded accent-primary" /> Lembrar de mim
          </label>
          <a href="#" class="text-sm text-primary hover:text-primary-dark font-medium">Esqueci a senha</a>
        </div>
        <button onclick="enterApp()" class="w-full py-3 xp-gradient hover:opacity-90 text-white font-bold rounded-xl transition text-sm shadow-md shadow-primary/30">
          Entrar na plataforma →
        </button>
        <div class="relative my-1">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
          <div class="relative flex justify-center"><span class="bg-white px-3 text-xs text-slate-400">ou</span></div>
        </div>
        <button class="w-full py-2.5 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 flex items-center justify-center gap-2 transition">
          <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Entrar com Google
        </button>
      </div>

      <!-- Register Form -->
      <div id="form-register" class="hidden space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Nome</label>
            <input type="text" placeholder="João" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Sobrenome</label>
            <input type="text" placeholder="Silva" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">E-mail</label>
          <input type="email" placeholder="aluno@escola.edu.br" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Código da escola</label>
          <input type="text" placeholder="ESC-2024-XXXXX" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">Senha</label>
          <input type="password" placeholder="Mín. 8 caracteres" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" />
        </div>
        <button onclick="enterApp()" class="w-full py-3 xp-gradient hover:opacity-90 text-white font-bold rounded-xl transition text-sm shadow-md shadow-primary/30">Criar conta →</button>
      </div>
    </div>

    <p class="text-center text-xs text-slate-500 mt-4">
      Ao entrar, você concorda com os <a href="#" class="underline text-slate-400">Termos de Uso</a> e a <a href="#" class="underline text-slate-400">Política de Privacidade LGPD</a>
    </p>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     APP SHELL
══════════════════════════════════════════════════════ -->
<div id="app-shell" class="hidden min-h-screen flex">

  <!-- ── SIDEBAR ── -->
  <aside class="hidden lg:flex flex-col w-60 bg-dark text-white fixed inset-y-0 left-0 z-30 overflow-y-auto">

    <!-- Logo -->
    <div class="flex items-center gap-2.5 px-5 py-5 border-b border-white/10">
      <div class="w-8 h-8 rounded-xl xp-gradient flex items-center justify-center flex-shrink-0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      </div>
      <span class="logo-text text-xl font-bold text-white">EstudAI</span>
    </div>

    <!-- User card -->
    <div class="flex items-center gap-3 px-4 py-4 border-b border-white/10">
      <div class="w-9 h-9 rounded-full xp-gradient flex items-center justify-center text-white font-bold text-sm flex-shrink-0" id="sidebar-avatar">JS</div>
      <div class="min-w-0">
        <p class="text-sm font-semibold truncate" id="sidebar-name">João Silva</p>
        <p class="text-xs text-slate-400 truncate" id="sidebar-role-label">Aluno · 3º Ano A</p>
      </div>
      <div class="ml-auto xp-gradient text-white text-xs font-bold px-2 py-0.5 rounded-full flex-shrink-0 leading-5">⚡ 1.2k</div>
    </div>

    <!-- Streak -->
    <div class="mx-4 mt-3 mb-1 bg-primary/15 border border-primary/25 rounded-xl px-3 py-2 flex items-center gap-2">
      <span class="text-lg">🔥</span>
      <div>
        <p class="text-xs font-bold text-primary">7 dias seguidos!</p>
        <p class="text-[10px] text-slate-400">Continue para ganhar bônus</p>
      </div>
    </div>

    <!-- Nav — dynamically filtered by role -->
    <nav class="flex-1 px-3 py-3 space-y-0.5" id="sidebar-nav">
      <!-- injected by JS based on role -->
    </nav>

    <!-- Footer -->
    <div class="px-3 py-3 border-t border-white/10 space-y-0.5">
      <a onclick="navigate('config')" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-pointer text-sm text-slate-300">
        <span class="text-base">⚙️</span> Configurações
      </a>
      <a onclick="showAuth()" class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-pointer text-sm text-slate-300">
        <span class="text-base">🚪</span> Sair
      </a>
    </div>
  </aside>

  <!-- ── MAIN AREA ── -->
  <div class="flex-1 flex flex-col lg:ml-60">

    <!-- TOPBAR -->
    <header class="bg-white border-b border-slate-200 px-4 lg:px-6 py-3 flex items-center gap-3 sticky top-0 z-20">
      <!-- Mobile logo -->
      <div class="lg:hidden flex items-center gap-2 mr-1">
        <div class="w-8 h-8 rounded-lg xp-gradient flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <span class="logo-text text-lg font-bold text-dark">EstudAI</span>
      </div>

      <h1 id="section-title" class="text-sm font-bold text-dark hidden lg:block"></h1>

      <!-- Search -->
      <div class="flex-1 max-w-sm mx-auto lg:mx-0 lg:ml-4">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="Buscar conteúdo, matérias..." class="w-full pl-9 pr-4 py-2 bg-slate-100 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/25 focus:bg-white transition border border-transparent focus:border-primary/25" />
        </div>
      </div>

      <!-- Right -->
      <div class="flex items-center gap-2 ml-auto">
        <div class="hidden sm:flex items-center gap-1.5 xp-gradient text-white text-xs font-bold px-3 py-1.5 rounded-full">⚡ 1.240 XP</div>
        <div class="hidden sm:flex items-center gap-1 bg-orange-50 border border-orange-200 text-orange-600 text-xs font-bold px-3 py-1.5 rounded-full">🔥 7</div>
        <!-- Notifications -->
        <button onclick="toggleNotifications()" class="relative w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition" id="notif-btn">
          <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span class="notif-dot" id="notif-indicator"></span>
        </button>
        <!-- Avatar -->
        <div onclick="navigate('config')" class="w-9 h-9 rounded-full xp-gradient flex items-center justify-center text-white font-bold text-sm cursor-pointer" id="topbar-avatar">JS</div>
      </div>
    </header>

    <!-- Notifications dropdown -->
    <div id="notif-panel" class="hidden fixed top-14 right-4 lg:right-6 bg-white rounded-2xl shadow-xl border border-slate-100 w-80 z-50 overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
        <p class="text-sm font-bold">Notificações</p>
        <button onclick="markAllRead()" class="text-xs text-primary font-medium">Marcar todas como lidas</button>
      </div>
      <div class="max-h-72 overflow-y-auto">
        <div class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 cursor-pointer border-l-2 border-primary">
          <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center text-base flex-shrink-0">🏆</div>
          <div>
            <p class="text-sm font-medium">Nova conquista desbloqueada!</p>
            <p class="text-xs text-slate-400">Você completou 7 dias seguidos · 2min atrás</p>
          </div>
        </div>
        <div class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 cursor-pointer border-l-2 border-transparent">
          <div class="w-8 h-8 bg-apoio1/10 rounded-lg flex items-center justify-center text-base flex-shrink-0">📊</div>
          <div>
            <p class="text-sm font-medium">Resultado do simulado disponível</p>
            <p class="text-xs text-slate-400">Biologia · Divisão Celular · ontem</p>
          </div>
        </div>
        <div class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 cursor-pointer border-l-2 border-transparent">
          <div class="w-8 h-8 bg-apoio2/10 rounded-lg flex items-center justify-center text-base flex-shrink-0">📝</div>
          <div>
            <p class="text-sm font-medium">Ana publicou um resumo de Biologia</p>
            <p class="text-xs text-slate-400">Rede Social · 2 dias atrás</p>
          </div>
        </div>
      </div>
    </div>

    <!-- PAGE CONTENT -->
    <main class="flex-1 overflow-y-auto pb-20 lg:pb-6">

      <!-- ── HOME ── -->
      <div id="page-home" class="page active p-4 lg:p-6 space-y-5">

        <!-- Welcome banner -->
        <div class="bg-gradient-to-r from-dark to-dark-2 rounded-2xl p-5 text-white relative overflow-hidden">
          <div class="absolute right-0 top-0 w-48 h-48 bg-primary/15 rounded-full -translate-y-1/3 translate-x-1/3"></div>
          <div class="absolute right-16 bottom-0 w-28 h-28 bg-apoio3/15 rounded-full translate-y-1/2"></div>
          <p class="text-sm text-slate-400 mb-0.5" id="home-greeting">Bom dia, João! 👋</p>
          <h2 class="text-xl font-bold mb-3">Continue de onde parou</h2>
          <div class="flex items-center gap-3 flex-wrap">
            <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-2.5">
              <p class="text-slate-400 text-xs">Última matéria</p>
              <p class="font-bold text-sm">Biologia · Cap. 4</p>
            </div>
            <button onclick="navigate('chat')" class="xp-gradient hover:opacity-90 text-white text-sm font-bold px-4 py-2.5 rounded-xl transition shadow-md shadow-primary/30">
              Continuar →
            </button>
          </div>
        </div>

        <!-- Stats + Progress side by side -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          <div class="bg-white rounded-xl p-4 border border-slate-100 card-hover cursor-pointer" onclick="navigate('resumos')">
