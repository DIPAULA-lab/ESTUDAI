  }

  function selectRole(role) {
    currentRole = role;
    document.querySelectorAll('.role-btn').forEach(b => {
      b.className = 'role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-slate-200 text-sm font-medium text-slate-500 transition hover:border-slate-300';
    });
    document.getElementById('role-' + role).className = 'role-btn flex items-center gap-2 p-3 rounded-xl border-2 border-primary bg-primary/5 text-sm font-medium text-primary transition';
  }

  function togglePassword(id) {
    const inp = document.getElementById(id);
    inp.type = inp.type === 'password' ? 'text' : 'password';
  }

  function enterApp() {
    document.getElementById('auth-page').style.display = 'none';
    document.getElementById('app-shell').classList.remove('hidden');
    buildSidebar();
    updateRoleUI();
    navigate('home');
    updateGreeting();
    startStudyTimer();
  }

  function showAuth() {
    document.getElementById('app-shell').classList.add('hidden');
    document.getElementById('auth-page').style.display = 'flex';
  }

  // ─── Role UI ─────────────────────────────────────────
  function buildSidebar() {
    const nav = document.getElementById('sidebar-nav');
    const cfg = navConfig[currentRole] || navConfig.student;
    nav.innerHTML = cfg.map(section => `
      <p class="px-3 pt-3 pb-1 text-[10px] font-bold uppercase tracking-widest text-slate-500">${section.section}</p>
      ${section.items.map(item => `
        <a onclick="navigate('${item.page}')" id="slink-${item.page}"
           class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-pointer text-sm text-slate-300">
          <span class="text-base">${item.icon}</span> ${item.label}
        </a>
      `).join('')}
    `).join('');
  }

  function updateRoleUI() {
    document.getElementById('sidebar-role-label').textContent = roleLabels[currentRole] || 'Aluno';
  }

  // ─── Navigation ──────────────────────────────────────
  function navigate(page) {
    // Chat page needs special display treatment
    document.querySelectorAll('.page').forEach(p => {
      p.classList.remove('active');
      p.style.display = 'none';
    });
    const target = document.getElementById('page-' + page);
    if (target) {
      if (page === 'chat') {
        target.style.display = 'flex';
        target.style.flexDirection = 'column';
      } else {
        target.style.display = 'flex';
        target.classList.add('active');
      }
    }
    document.getElementById('section-title').textContent = titles[page] || page;

    // Sidebar links
    document.querySelectorAll('.sidebar-link').forEach(l => {
      l.classList.remove('active', 'text-slate-300');
      l.classList.add('text-slate-300');
    });
    const active = document.getElementById('slink-' + page);
    if (active) { active.classList.add('active'); active.classList.remove('text-slate-300'); }

    // Mobile nav
    document.querySelectorAll('.mobile-nav-btn').forEach(b => {
      b.classList.remove('active');
      b.querySelectorAll('.nav-icon,.nav-label').forEach(el => {
        el.classList.remove('text-primary');
        if (el.classList.contains('nav-icon')) el.classList.add('text-slate-400');
        if (el.classList.contains('nav-label')) el.classList.add('text-slate-400');
      });
    });
    const mactive = document.getElementById('mnav-' + page);
    if (mactive) {
      mactive.classList.add('active');
      mactive.querySelectorAll('.nav-icon,.nav-label').forEach(el => {
        el.classList.add('text-primary');
        el.classList.remove('text-slate-400');
      });
    }

    currentPage = page;
    // Close notifications
    document.getElementById('notif-panel').classList.add('hidden');
  }

  // ─── Greeting ────────────────────────────────────────
  function updateGreeting() {
    const h = new Date().getHours();
    const g = h < 12 ? 'Bom dia' : h < 18 ? 'Boa tarde' : 'Boa noite';
    document.getElementById('home-greeting').textContent = `${g}, João! 👋`;
  }

  // ─── Study Timer ─────────────────────────────────────
  function startStudyTimer() {
    setInterval(() => {
      studySeconds++;
      const m = Math.floor(studySeconds/60).toString().padStart(2,'0');
      const s = (studySeconds%60).toString().padStart(2,'0');
      const el = document.getElementById('study-timer');
      if (el) el.textContent = `00:${m}:${s}`;
    }, 1000);
  }

  // ─── Notifications ───────────────────────────────────
  function toggleNotifications() {
    const p = document.getElementById('notif-panel');
    p.classList.toggle('hidden');
    document.getElementById('notif-indicator').style.display = 'none';
  }
  function markAllRead() {
    document.querySelectorAll('#notif-panel .border-primary').forEach(el => {
      el.classList.remove('border-primary');
      el.classList.add('border-transparent');
    });
    document.getElementById('notif-indicator').style.display = 'none';
    document.getElementById('notif-panel').classList.add('hidden');
  }

  // ─── Chat ────────────────────────────────────────────
  let chatCtx = 'bio';
  function setChatContext(ctx) {
    chatCtx = ctx;
    document.querySelectorAll('.ctx-btn').forEach(b => {
      b.className = 'ctx-btn flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-full bg-white text-slate-500 border-2 border-slate-200 flex-shrink-0 transition hover:border-slate-300';
    });
    const colors = { bio:'apoio1', mat:'apoio3', qui:'apoio2', his:'primary', fis:'apoio1' };
    const c = colors[ctx] || 'primary';
    const btn = document.getElementById('ctx-' + ctx);
    if (btn) btn.className = `ctx-btn flex items-center gap-1 text-xs font-bold px-3 py-1.5 rounded-full bg-${c}/10 text-${c} border-2 border-${c} flex-shrink-0 transition`;
  }

  function sendMessage() {
    const inp = document.getElementById('chat-input');
    const msg = inp.value.trim();
    if (!msg) return;
    inp.value = '';

    // Add user bubble
    const msgs = document.getElementById('chat-messages');
    const userDiv = document.createElement('div');
    userDiv.className = 'flex gap-3 max-w-2xl ml-auto flex-row-reverse';
    userDiv.innerHTML = `
      <div class="w-8 h-8 rounded-full xp-gradient flex items-center justify-center text-white text-xs font-bold flex-shrink-0">JS</div>
      <div class="bg-white rounded-2xl rounded-tr-sm px-4 py-3 border border-primary/20 shadow-sm">
        <p class="text-sm text-dark">${msg}</p>
      </div>`;
    msgs.appendChild(userDiv);

    // Show typing
    document.getElementById('typing-indicator').classList.remove('hidden');
    msgs.scrollTop = msgs.scrollHeight;

    // Fake AI response
    setTimeout(() => {
      document.getElementById('typing-indicator').classList.add('hidden');
      const aiDiv = document.createElement('div');
      aiDiv.className = 'flex gap-3 max-w-2xl';
      aiDiv.innerHTML = `
        <div class="w-8 h-8 rounded-xl xp-gradient flex items-center justify-center flex-shrink-0 shadow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14a2 2 0 1 0 4 0 2 2 0 0 0-4 0m6 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg>
        </div>
        <div class="bg-white rounded-2xl rounded-tl-sm px-4 py-3 border border-slate-100 shadow-sm space-y-2">
          <p class="text-sm text-slate-700">Ótima pergunta! Com base no seu livro didático, vou explicar esse conceito de forma clara e precisa, seguindo exatamente o que está no material da sua escola.</p>
          <div class="flex flex-wrap gap-1.5 mt-1">
            <span class="inline-flex items-center gap-1 text-xs bg-apoio1/10 text-apoio1 border border-apoio1/20 px-2 py-0.5 rounded-full font-medium">📖 Cap.4 · p.72</span>
          </div>
          <div class="flex gap-3 pt-1 border-t border-slate-100">
            <button onclick="navigate('resumos')" class="text-xs text-slate-400 hover:text-apoio3 transition font-medium">📝 Resumo</button>
            <button onclick="navigate('podcasts')" class="text-xs text-slate-400 hover:text-apoio3 transition font-medium">🎙️ Podcast</button>
            <button onclick="navigate('simulados')" class="text-xs text-slate-400 hover:text-apoio3 transition font-medium">📋 Simulado</button>
          </div>
        </div>`;
      msgs.appendChild(aiDiv);
      msgs.scrollTop = msgs.scrollHeight;
    }, 1800);

    msgs.scrollTop = msgs.scrollHeight;
  }

  function newChat() {
    const msgs = document.getElementById('chat-messages');
    msgs.innerHTML = `
      <div class="flex gap-3 max-w-2xl">
        <div class="w-8 h-8 rounded-xl xp-gradient flex items-center justify-center flex-shrink-0 shadow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14a2 2 0 1 0 4 0 2 2 0 0 0-4 0m6 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg>
        </div>
        <div class="bg-white rounded-2xl rounded-tl-sm px-4 py-3 border border-slate-100 shadow-sm">
          <p class="text-sm text-slate-700">Nova conversa iniciada! 🤖 Selecione a matéria e me faça uma pergunta.</p>
        </div>
      </div>`;
  }

  // ─── Podcast ─────────────────────────────────────────
  function togglePodcast() {
    podcastPlaying = !podcastPlaying;
    const btn = document.getElementById('pod-play-btn');
    const wave = document.getElementById('wave-container');

    if (podcastPlaying) {
      btn.textContent = '⏸';
      wave.style.display = 'flex';
      podcastInterval = setInterval(() => {
        podcastPct = Math.min(podcastPct + 0.2, 100);
        document.getElementById('pod-progress').style.width = podcastPct + '%';
        document.getElementById('pod-thumb').style.left = 'calc(' + podcastPct + '% - 7px)';
        const totalSecs = 504; // 8:24
        const cur = Math.floor(totalSecs * podcastPct / 100);
        const m = Math.floor(cur/60);
        const s = (cur%60).toString().padStart(2,'0');
        document.getElementById('pod-current').textContent = m + ':' + s;
        if (podcastPct >= 100) { clearInterval(podcastInterval); podcastPlaying = false; btn.textContent = '▶'; wave.style.display = 'none'; }
      }, 200);
    } else {
      btn.textContent = '▶';
      wave.style.display = 'none';
      clearInterval(podcastInterval);
    }
  }

  function seekPodcast(e) {
    const track = document.getElementById('pod-track');
    const rect = track.getBoundingClientRect();
    podcastPct = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
    document.getElementById('pod-progress').style.width = podcastPct + '%';
    document.getElementById('pod-thumb').style.left = 'calc(' + podcastPct + '% - 7px)';
  }

  // ─── Quiz ────────────────────────────────────────────
  const quizQuestions = [
    { q:'Qual é a principal diferença entre mitose e meiose em relação ao número de células filhas produzidas?', opts:['A) Mitose produz 2; meiose produz 2','B) Mitose produz 2; meiose produz 4','C) Mitose produz 4; meiose produz 2','D) Ambas produzem 4 células filhas'], correct:1, page:'p.87' },
    { q:'O que são cromossomos homólogos?', opts:['A) Cromossomos idênticos','B) Cromossomos do sexo','C) Par de cromossomos com genes nos mesmos loci, um de cada progenitor','D) Cromossomos após a replicação'], correct:2, page:'p.89' },
    { q:'Em qual fase da mitose os cromossomos se alinham no plano equatorial da célula?', opts:['A) Prófase','B) Metáfase','C) Anáfase','D) Telófase'], correct:1, page:'p.91' },
    { q:'A meiose é essencial para:', opts:['A) O crescimento do organismo','B) A regeneração de tecidos','C) A formação de gametas com n cromossomos','D) A divisão das células somáticas'], correct:2, page:'p.94' },
    { q:'O que é crossing-over?', opts:['A) Duplicação do DNA','B) Troca de segmentos entre cromátides homólogas','C) Separação de cromossomos na anáfase','D) Divisão do citoplasma'], correct:1, page:'p.97' },
  ];

  function startQuiz() {
    quizCurrentQ = 0;
    quizCorrect = 0;
    quizAnswered = false;
    document.getElementById('quiz-list-view').classList.add('hidden');
    document.getElementById('quiz-result-view').classList.add('hidden');
    document.getElementById('quiz-active-view').classList.remove('hidden');
    loadQuestion();
  }

  function loadQuestion() {
    const q = quizQuestions[quizCurrentQ];
    document.getElementById('q-current').textContent = quizCurrentQ + 1;
    document.getElementById('q-total').textContent = quizQuestions.length;
    document.getElementById('quiz-question').textContent = q.q;
    document.getElementById('quiz-progress-bar').style.width = ((quizCurrentQ) / quizQuestions.length * 100) + '%';
    document.getElementById('quiz-score-badge').textContent = quizCorrect;

    const opts = document.getElementById('quiz-options');
    opts.innerHTML = q.opts.map((o,i) => `
      <button onclick="answerQuiz(this,${i===q.correct})"
        class="quiz-option w-full text-left px-4 py-3 rounded-xl border-2 border-slate-200 text-sm font-medium transition">${o}</button>
    `).join('');

    document.getElementById('quiz-feedback').classList.add('hidden');
    document.getElementById('quiz-next-btn').classList.add('hidden');
    quizAnswered = false;
  }

  function answerQuiz(btn, correct) {
    if (quizAnswered) return;
    quizAnswered = true;
    if (correct) {
      btn.classList.add('correct');
      quizCorrect++;
      document.getElementById('quiz-score-badge').textContent = quizCorrect;
    } else {
      btn.classList.add('wrong');
      // Show correct
      const q = quizQuestions[quizCurrentQ];
      document.querySelectorAll('.quiz-option')[q.correct].classList.add('correct');
    }
    // Disable all
    document.querySelectorAll('.quiz-option').forEach(b => b.disabled = true);
    const fb = document.getElementById('quiz-feedback');
    fb.classList.remove('hidden');
    if (correct) {
      fb.className = 'mt-4 p-3 rounded-xl text-sm font-bold bg-apoio2/10 text-apoio2';
      fb.textContent = '✓ Correto! +20 XP · 📖 ' + quizQuestions[quizCurrentQ].page;
    } else {
      fb.className = 'mt-4 p-3 rounded-xl text-sm font-bold bg-red-50 text-red-600';
      fb.textContent = '✗ Incorreto. Reveja · 📖 ' + quizQuestions[quizCurrentQ].page;
    }
    document.getElementById('quiz-next-btn').classList.remove('hidden');
  }

  function nextQuestion() {
    quizCurrentQ++;
    if (quizCurrentQ >= quizQuestions.length) {
      showQuizResult();
    } else {
      loadQuestion();
    }
  }

  function showQuizResult() {
    document.getElementById('quiz-active-view').classList.add('hidden');
    document.getElementById('quiz-result-view').classList.remove('hidden');
    const pct = Math.round(quizCorrect / quizQuestions.length * 100);
    document.getElementById('result-score').textContent = quizCorrect + '/' + quizQuestions.length + ' corretas';
    document.getElementById('result-pct').textContent = pct + '% de acerto';
    document.getElementById('result-xp').textContent = '+' + (quizCorrect * 20) + ' XP ganhos!';
    document.getElementById('result-emoji').textContent = pct >= 80 ? '🏆' : pct >= 60 ? '👍' : '📖';
  }

  function exitQuiz() {
    document.getElementById('quiz-active-view').classList.add('hidden');
    document.getElementById('quiz-result-view').classList.add('hidden');
    document.getElementById('quiz-list-view').classList.remove('hidden');
  }

  // ─── Games ───────────────────────────────────────────
  function openGame(type) {
    if (type === 'flashcard') {
      document.getElementById('game-selection').classList.add('hidden');
      document.getElementById('flashcard-game').classList.remove('hidden');
    }
  }

  function closeGame() {
    document.getElementById('flashcard-game').classList.add('hidden');
    document.getElementById('game-selection').classList.remove('hidden');
    document.getElementById('flashcard-el').classList.remove('flipped');
  }

  function flipCard() {
    document.getElementById('flashcard-el').classList.toggle('flipped');
  }

  // ─── Generate Modal ──────────────────────────────────
  function openGenerateModal(type) {
    const labels = { resumo:'Gerar novo resumo', podcast:'Gerar novo podcast', simulado:'Criar novo simulado' };
    document.getElementById('modal-title').textContent = labels[type] || 'Gerar conteúdo';
    const extra = document.getElementById('modal-extra');
    if (type === 'simulado') {
      extra.innerHTML = `<div>
        <label class="block text-xs font-bold text-slate-600 mb-1.5">Número de questões</label>
        <div class="flex gap-2">
          <button onclick="selectQCount(this,5)" class="flex-1 py-2 rounded-xl border-2 border-primary bg-primary/5 text-primary text-sm font-bold">5</button>
          <button onclick="selectQCount(this,10)" class="flex-1 py-2 rounded-xl border-2 border-slate-200 text-slate-500 text-sm font-bold">10</button>
          <button onclick="selectQCount(this,15)" class="flex-1 py-2 rounded-xl border-2 border-slate-200 text-slate-500 text-sm font-bold">15</button>
        </div>
      </div>`;
    } else if (type === 'podcast') {
      extra.innerHTML = `<div>
        <label class="block text-xs font-bold text-slate-600 mb-1.5">Duração estimada</label>
        <div class="flex gap-2">
          <button class="flex-1 py-2 rounded-xl border-2 border-primary bg-primary/5 text-primary text-sm font-bold">~5 min</button>
          <button class="flex-1 py-2 rounded-xl border-2 border-slate-200 text-slate-500 text-sm font-bold">~10 min</button>
          <button class="flex-1 py-2 rounded-xl border-2 border-slate-200 text-slate-500 text-sm font-bold">~15 min</button>
        </div>
      </div>`;
    } else {
      extra.innerHTML = '';
    }
    document.getElementById('generate-modal').classList.remove('hidden');
  }

  function selectQCount(btn, n) {
    btn.parentElement.querySelectorAll('button').forEach(b => {
      b.className = 'flex-1 py-2 rounded-xl border-2 border-slate-200 text-slate-500 text-sm font-bold';
    });
    btn.className = 'flex-1 py-2 rounded-xl border-2 border-primary bg-primary/5 text-primary text-sm font-bold';
  }

  function closeModal() {
    document.getElementById('generate-modal').classList.add('hidden');
  }

  // Close modal on backdrop click
  document.getElementById('generate-modal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });

  // ─── Toggle switch ───────────────────────────────────
  function toggleSwitch(el) {
    const dot = el.querySelector('div');
    if (el.classList.contains('bg-apoio2')) {
      el.classList.replace('bg-apoio2','bg-slate-200');
      dot.classList.replace('right-0.5','left-0.5');
    } else {
      el.classList.replace('bg-slate-200','bg-apoio2');
      dot.classList.replace('left-0.5','right-0.5');
    }
  }

  // ─── Upload helpers ──────────────────────────────────
  function handleFileSelect(e) { const f = e.target.files[0]; if(f) showFileInfo(f); }
  function handleDrop(e) {
    e.preventDefault();
    document.getElementById('drop-zone').classList.remove('border-primary','bg-primary/5');
    const f = e.dataTransfer.files[0];
    if(f && f.type==='application/pdf') showFileInfo(f);
  }
  function showFileInfo(f) {
    document.getElementById('drop-zone').classList.add('hidden');
    document.getElementById('file-selected').classList.remove('hidden');
    document.getElementById('file-name').textContent = f.name;
    document.getElementById('file-size').textContent = (f.size/1024/1024).toFixed(2)+' MB';
  }
  function clearFile() {
    document.getElementById('drop-zone').classList.remove('hidden');
    document.getElementById('file-selected').classList.add('hidden');
    document.getElementById('pdf-input').value='';
  }
  function startUpload() {
    const title = document.getElementById('book-title').value.trim();
    const subject = document.getElementById('book-subject').value;
    const fi = document.getElementById('pdf-input');
    if(!title||!subject||!fi.files[0]) { alert('Preencha título, disciplina e selecione um PDF.'); return; }
    const btn = event.currentTarget;
    btn.innerHTML = '<span class="animate-spin">⏳</span> Enviando...';
    btn.disabled = true;
    let pct = 0;
    const bar = document.getElementById('ingest-progress');
    const t = setInterval(()=>{ pct=Math.min(pct+Math.random()*8,95); if(bar) bar.style.width=pct+'%'; },400);
    setTimeout(()=>{
      clearInterval(t);
      if(bar) bar.style.width='100%';
      btn.innerHTML = '✅ Ingestão iniciada!';
      setTimeout(()=>{ btn.innerHTML='<span>☁️</span> Upload e Iniciar Ingestão'; btn.disabled=false; clearFile(); document.getElementById('book-title').value=''; document.getElementById('book-subject').value=''; if(bar) bar.style.width='57%'; },2000);
    },3500);
  }

  // ─── Book filter ─────────────────────────────────────
  function filterBooks(f) {}

  // ─── Init ────────────────────────────────────────────
  document.getElementById('auth-page').style.display = 'flex';
</script>
</body>
</html>